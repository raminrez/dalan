---
import { DalanConverter } from "../components/DalanConverter";
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>دالان | Dalan — تبدیل امن PDF به کتاب‌خوان کیندل</title>
    <meta name="description" content="تبدیل کاملاً کلاینت‌ساید اسناد PDF به EPUB با بهینه‌سازی فونت وزیرمتن و پشتیبانی دوطرفه از کیندل آمازون" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="stylesheet" href="/hashti-styles.css" />
    <link rel="stylesheet" href="/styles.css" />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.warn('Service worker registration failed:', err);
          });
        });
      }
    </script>
  </head>
  <body>
    <DalanConverter client:load />
  </body>
</html>
